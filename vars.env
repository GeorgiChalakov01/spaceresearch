# === MINIO CONFIGURATION ===
MINIO_ENDPOINT=objectstorage:9000
MINIO_ROOT_USER=changeme
MINIO_ROOT_PASSWORD=changeme

# === DATABASE CONFIGURATION ===
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=app

# === RABBITMQ CONFIGURATION ===
RABBITMQ_DEFAULT_USER=changeme
RABBITMQ_DEFAULT_PASS=changeme

# === BACKEND CONFIGURATION ===
BACKEND_PORT=8080
DB_USER=changeme # Same as POSTGRES_USER
DB_PWD=changeme # Same as POSTGRES_PASSWORD
DB_PORT=changeme # Same as POSTGRES_PORT
DB_SCHEMA=app # Same as POSTGRES_DB
DB_PORT=5432 # Same as POSTGRES_DB
DB_CONTAINER_NAME=database
