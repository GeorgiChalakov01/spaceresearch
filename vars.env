# === MINIO CONFIGURATION === #
MINIO_ROOT_USER=changeme
MINIO_ROOT_PASSWORD=changeme

# === DATABASE CONFIGURATION === #
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=app

# === RABBITMQ CONFIGURATION === #
RABBITMQ_DEFAULT_USER=changeme
RABBITMQ_DEFAULT_PASS=changeme

# === BACKEND CONFIGURATION === #
BACKEND_PORT=8080
# --- MinIO --- #
MINIO_PORT=9000
MINIO_CONTAINER_NAME=objectstorage
# --- Postgre --- #
POSTGRES_PORT=5432
POSTGRES_CONTAINER_NAME=database
# --- RabbitMQ --- #
RABBITMQ_CONTAINER_NAME=messagebroker
RABBITMQ_PORT=5672
# --- Ollama --- #
OLLAMA_CHAT_ENDPOINT=http://192.168.0.27:11434/api/chat
#OLLAMA_CHAT_ENDPOINT=http://ollama:11434/api/chat
OLLAMA_MODEL="gemma3:4b-it-qat"
